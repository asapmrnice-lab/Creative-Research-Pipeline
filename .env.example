# Creative Research Pipeline -- copy to .env and fill in.
# .env is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# Collection-time keyword filter
# ---------------------------------------------------------------------------
# Only posts whose text matches one of these keywords are ingested.
# Comma-separated. A post that matches nothing is never stored, so adding a
# keyword later does NOT backfill older posts.
INGEST_KEYWORDS=креатив,креативчик,крео,креос,кейс

# whole-word | substring
#   whole-word : "креатив" matches "креатив", not "креативный"
#   substring  : "креатив" matches anything containing those letters
INGEST_KEYWORD_MATCH=whole-word

# Allow Russian noun endings on a whole-word match, so "креативы",
# "креативом", "креативах" still count as the same keyword. Set false for
# strict literal whole-word matching.
INGEST_KEYWORD_INFLECTIONS=true

# ---------------------------------------------------------------------------
# Collection-time channel scope
# ---------------------------------------------------------------------------
# Which channels the gate will collect from, as the platform's own numeric ids,
# comma-separated. Keep this in step with CHAT_IDS in the archive tool's .env:
# that one decides what gets downloaded, this one decides what gets collected.
#
# It matters because the archive is a shared, unfiltered pile that outlives any
# one channel list. Swap a channel and its old posts stay in the archive, so a
# re-run of ingest would quietly collect them again. This is the line that
# stops that.
#
# EMPTY MEANS EVERY CHANNEL, deliberately -- an unset value must not turn into
# a silent collection stoppage. Every run prints the scope it is enforcing, so
# "unrestricted" is visible rather than assumed.
#
#   INGEST_CHANNELS=-1001107320646,-1001405870032
INGEST_CHANNELS=

# ---------------------------------------------------------------------------
# Trial archive (read-only source for keyword reports)
# ---------------------------------------------------------------------------
TRIAL_DB_PATH=./trial/telegram-archive/data/backups/telegram_backup.db

# ---------------------------------------------------------------------------
# Our own store -- written by scripts/ingest.py, and only ever holds posts
# the keyword gate accepted.
# ---------------------------------------------------------------------------
# sqlite | supabase
#   sqlite   : a local file. No credentials, no network, works offline. This is
#              what the test suite runs against.
#   supabase : the shared Postgres project. Needs SUPABASE_DB_URL below and
#              `pip install "psycopg[binary]"`.
# Passing --db to any script forces sqlite, since a file path cannot mean
# Supabase.
STORE_BACKEND=sqlite

STORE_DB_PATH=./data/research.db

# ---------------------------------------------------------------------------
# Local review page (scripts/serve_review.py)
# ---------------------------------------------------------------------------
# The page has no login. Keep the host on loopback unless you have a reason
# not to -- anything else publishes your collected research to the network.
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8001

# ---------------------------------------------------------------------------
# Noise cleaning (deterministic -- runs with or without a model)
# ---------------------------------------------------------------------------
# Per-channel boilerplate to strip: a JSON array of regexes, case-insensitive,
# matched per line. Empty means the universal steps only (unicode folding,
# invisible characters, tracking parameters, whitespace).
#
# JSON, not a comma-separated list, because a regex may contain a comma.
# The machine never adds a pattern here -- deciding that a span is the
# channel's boilerplate is your call, exactly like the keyword list.
#
#   CLEAN_DROP_PATTERNS=["^Подписывайся.*$", "^Реклама:.*$"]
CLEAN_DROP_PATTERNS=

# ---------------------------------------------------------------------------
# Near-duplicate detection (deterministic -- no model)
# ---------------------------------------------------------------------------
# How many bits of a 64-bit SimHash may differ before two posts are flagged as
# near-duplicates. Lower is stricter.
#
# 12 is measured against the real posts in tests/fixtures rather than picked:
# reposts with edits (reflowed, footer added, header prepended) came within
# 9 bits, and no two unrelated posts came closer than 17. Below ~8 you start
# missing genuine reposts; above ~16 unrelated posts begin matching.
#
# Flags only -- nothing is ever merged or deleted, and you decide in review.
DEDUP_SIMHASH_DISTANCE=12

# ---------------------------------------------------------------------------
# Anthropic -- the model stages (plan §3)
# ---------------------------------------------------------------------------
# LEAVE THE KEY EMPTY TO RUN WITHOUT A MODEL. That is a supported setup, not a
# broken one: deterministic cleaning, exact + near-duplicate detection and
# language/format labelling all work with no key and no network. The model
# stages simply report themselves as skipped and write nothing.
#
# With a key set, the model is allowed to do only what plan §3 permits:
# strip boilerplate (verified to be deletion-only) and extract whitelisted
# fields (constrained by a JSON schema). It never judges a post.
ANTHROPIC_API_KEY=

# Haiku is the right tier for mechanical extraction and cleaning, and the
# cheapest capable one. Swap to claude-sonnet-5 to reprocess posts a
# low-confidence extraction flagged.
ANTHROPIC_MODEL=claude-haiku-4-5

# Turn the model off while keeping the key on disk. Useful for a dry run.
LLM_ENABLED=true

# true  : Message Batches API -- half price, results within the hour. This is
#         right for passive collection, which nobody is waiting on.
# false : one request at a time, answers immediately. For interactive
#         reprocessing of a handful of posts.
LLM_BATCH=true

# ---------------------------------------------------------------------------
# Supabase (needed when STORE_BACKEND=supabase)
# ---------------------------------------------------------------------------
# The Postgres connection string, from the dashboard:
#   Settings -> Database -> Connection string -> URI
# It contains your database password, so it is a secret like any other. Scripts
# print it with the password stripped, but never paste the raw value anywhere.
# Run migrations/0001_init.sql against the project once before first use.
SUPABASE_DB_URL=

# The REST/Storage credentials. NOT needed to store posts -- these are for the
# Storage bucket that media downloads will use later. Leave empty until then.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
