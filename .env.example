# Creative Research Pipeline -- copy to .env and fill in.
# .env is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# Collection-time keyword filter
# ---------------------------------------------------------------------------
# Only posts whose text matches one of these keywords are ingested.
# Comma-separated. A post that matches nothing is never stored, so adding a
# keyword later does NOT backfill older posts.
INGEST_KEYWORDS=креатив,креативчик,крео,креос,кейс

# whole-word | substring
#   whole-word : "креатив" matches "креатив", not "креативный"
#   substring  : "креатив" matches anything containing those letters
INGEST_KEYWORD_MATCH=whole-word

# Allow Russian noun endings on a whole-word match, so "креативы",
# "креативом", "креативах" still count as the same keyword. Set false for
# strict literal whole-word matching.
INGEST_KEYWORD_INFLECTIONS=true

# ---------------------------------------------------------------------------
# Trial archive (read-only source for keyword reports)
# ---------------------------------------------------------------------------
TRIAL_DB_PATH=./trial/telegram-archive/data/backups/telegram_backup.db

# ---------------------------------------------------------------------------
# Our own store -- written by scripts/ingest.py, and only ever holds posts
# the keyword gate accepted.
# ---------------------------------------------------------------------------
# sqlite | supabase
#   sqlite   : a local file. No credentials, no network, works offline. This is
#              what the test suite runs against.
#   supabase : the shared Postgres project. Needs SUPABASE_DB_URL below and
#              `pip install "psycopg[binary]"`.
# Passing --db to any script forces sqlite, since a file path cannot mean
# Supabase.
STORE_BACKEND=sqlite

STORE_DB_PATH=./data/research.db

# ---------------------------------------------------------------------------
# Local review page (scripts/serve_review.py)
# ---------------------------------------------------------------------------
# The page has no login. Keep the host on loopback unless you have a reason
# not to -- anything else publishes your collected research to the network.
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8001

# ---------------------------------------------------------------------------
# Anthropic (needed from plan stage 5 onward -- extraction & cleaning)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Supabase (needed when STORE_BACKEND=supabase)
# ---------------------------------------------------------------------------
# The Postgres connection string, from the dashboard:
#   Settings -> Database -> Connection string -> URI
# It contains your database password, so it is a secret like any other. Scripts
# print it with the password stripped, but never paste the raw value anywhere.
# Run migrations/0001_init.sql against the project once before first use.
SUPABASE_DB_URL=

# The REST/Storage credentials. NOT needed to store posts -- these are for the
# Storage bucket that media downloads will use later. Leave empty until then.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
